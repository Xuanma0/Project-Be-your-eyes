# Copy this file to .env, then fill in your DeepSeek API key.
#
# DeepSeek official OpenAI-compatible endpoint:
# https://api.deepseek.com
#
# Current V4 model IDs:
# - deepseek-v4-flash: faster and cheaper, good default for planner/orchestrator
# - deepseek-v4-pro: stronger reasoning, slower and more expensive

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local runtime defaults.
BYE_ASR_MODEL=small
BYE_ASR_DEVICE=auto
BYE_ASR_COMPUTE_TYPE=auto
BYE_VOICE_SIDECAR_URL=http://127.0.0.1:8010
BYE_VOICE_SIDECAR_TIMEOUT=90
BYE_ENABLE_TRACKER_SIDECAR=1
BYE_TRACKER_SIDECAR_URL=http://127.0.0.1:8020
BYE_TRACKER_SIDECAR_TIMEOUT=12
BYE_TRACKER_MAX_WIDTH=384
BYE_TRACKER_HYBRID_CV=1
BYE_TRACKER_OPENCV_BACKEND=lk
BYE_YOLO_MODEL=yolo26s.pt
BYE_BASE_YOLO_MODE=scene
BYE_ENABLE_YOLOE=1
BYE_YOLOE_MODEL=yoloe-26s-seg.pt
BYE_YOLOE_CONF=0.12
BYE_YOLO_WORLD_MODEL=yolov8s-worldv2.pt
BYE_ENABLE_YOLO_WORLD=1
BYE_YOLO_WORLD_CONF=0.12
BYE_ENABLE_SAM3=1
BYE_SAM3_MODEL=sam3.pt
BYE_SAM3_CONF=0.22
BYE_CAMERA_INDEX=0
BYE_CAMERA_WIDTH=1280
BYE_CAMERA_HEIGHT=720
BYE_CAMERA_FPS=30
BYE_STREAM_WIDTH=640
BYE_STREAM_FPS=15
BYE_ENABLE_HAND_TRACKING=1
BYE_HAND_MODEL=D:\Be-your-eyes\data\models\hand_landmarker.task
BYE_HAND_DETECT_CONF=0.45
BYE_HAND_TRACK_CONF=0.45
BYE_ENABLE_DEPTH=1
BYE_DEPTH_MODEL=models\DA3-SMALL
BYE_DEPTH_PROCESS_RES=392
BYE_DEPTH_INTERVAL=2.5
